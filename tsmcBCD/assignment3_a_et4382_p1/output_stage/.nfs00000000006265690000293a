; ============================================================
; Assignment 3A Part 1 - ADE L Setup Script
;
; HOW TO USE:
; 1. Open output_stage schematic in Cadence
; 2. Launch ADE L: Launch > ADE L
; 3. In CIW type: load("/home/datyukov/tsmcBCD/assignment3_a_et4382_p1/output_stage/setup_p1.il")
; 4. After it runs, save state: Session > Save State > "a3a_p1_sims"
; ============================================================

; Get the current ADE L session
sess = asiGetCurrentSession()

if(sess then
  printf("Found ADE L session, configuring...\n")

  ; ---------- Analysis: Transient ----------
  asiSetAnalysis(sess "tran" ?params list("stop" "10u" "errpreset" "conservative"))

  ; ---------- Design Variables ----------
  asiSetDesignVarList(sess '(
    ("deadtime" "5n")
    ("iload" "2")
    ("fsw" "500k")
    ("nf" "100")
    ("pmos_w" "3u")
    ("nmos_w" "pmos_w*4")
  ))

  ; ---------- Outputs ----------
  asiSetOutputList(sess '(
    (v "/input")
    (v "/O+")
    (v "/O-")
    (v "/Vgh")
    (v "/Vgl")
    (v "/sw")
    (i "/V3/PLUS")
    (i "/V3/MINUS")
  ))

  printf("=== ADE L Setup complete ===\n")
  printf("Analysis: tran 0->10u conservative\n")
  printf("Variables: deadtime=5n iload=2 fsw=500k nf=100 pmos_w=3u nmos_w=pmos_w*4\n")
  printf("Outputs: /input /O+ /O- /Vgh /Vgl /sw /V3/PLUS /V3/MINUS\n")
  printf("\nNow save state: Session > Save State > Name: a3a_p1_sims\n")
else
  printf("ERROR: No active ADE L session found!\n")
  printf("Make sure ADE L is open, then run this script again.\n")
)
